DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
# Add your actual host if running outside GitHub Codespaces.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Development settings automatically trust localhost and *.app.github.dev.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Public URL used in invitation emails. Use your current Codespaces forwarded URL.
DJANGO_SITE_URL=https://YOUR-CODESPACE-8000.app.github.dev
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_DEFAULT_CURRENCY=NPR
DJANGO_DEFAULT_TIME_ZONE=Asia/Kathmandu
DJANGO_DEMO_PASSWORD=ChangeThisDemoPassword123!

# Transactional email for farm-owner invitations and account notifications.
# If EMAIL_HOST is blank, Django writes email content to the development console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=no-reply@your-domain.example
